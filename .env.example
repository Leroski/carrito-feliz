# Copia este archivo a .env.local y completa con los valores de `npx supabase status`
# (o de Project Settings → API en supabase.com).
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública: "anon" o "publishable"
SUPABASE_ANON_KEY=
# Clave privada: "service_role" o "secret". Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
